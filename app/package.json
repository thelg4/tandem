{
  "name": "tandem-live",
  "private": true,
  "version": "0.0.1",
  "description": "Tandem live workspace: real agent CLIs beside a live repo map.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "d3-hierarchy": "3.1.2",
    "node-pty": "1.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.2",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "electron": "37.10.3",
    "electron-vite": "4.0.1",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "3.2.4"
  }
}
